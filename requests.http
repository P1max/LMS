@baseUrl = http://localhost:3000
@token = paste-token-here

### Зарегистрировать студента
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "student@lms.local",
  "password": "Student123!"
}

### Войти администратором (пароль из seed)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@lms.local",
  "password": "Admin123!"
}

### Получить профиль текущего пользователя
GET {{baseUrl}}/profile
Authorization: Bearer {{token}}

### Получить пользователей (только для роли admin)
GET {{baseUrl}}/admin/users
Authorization: Bearer {{token}}

### Проверить защиту профиля без токена
GET {{baseUrl}}/profile

### Проверка сервера
GET {{baseUrl}}/

### Получить все курсы
GET {{baseUrl}}/courses

### Фильтрация по статусу и поиск
GET {{baseUrl}}/courses?status=published&search=web

### Получить курс по ID
GET {{baseUrl}}/courses/1

### Создать курс (после миграций и seed он получит ID 3)
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "title": "Электронный журнал",
  "description": "Оценки и посещаемость",
  "teacher": "Елена Волкова",
  "durationHours": 40,
  "status": "draft",
  "startDate": "2026-11-01T09:00:00.000Z"
}

### Полностью обновить созданный курс
PUT {{baseUrl}}/courses/3
Content-Type: application/json

{
  "title": "Электронный журнал",
  "description": "Оценки, расписание и посещаемость",
  "teacher": "Елена Волкова",
  "durationHours": 44,
  "status": "published",
  "startDate": "2026-11-05T09:00:00.000Z"
}

### Удалить созданный курс
DELETE {{baseUrl}}/courses/3

### Проверить ошибку 404 после удаления
GET {{baseUrl}}/courses/3

### Проверить ошибку 400
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "title": ""
}

### ПЗ2: получить описание API
GET {{baseUrl}}/api/v1

### ПЗ2: получить курсы с фильтрами
GET {{baseUrl}}/api/v1/courses?status=published&search=web

### ПЗ2: получить курс по ID
GET {{baseUrl}}/api/v1/courses/1

### ПЗ2: создать курс (при чистом запуске его ID будет 3)
POST {{baseUrl}}/api/v1/courses
Content-Type: application/json

{
  "title": "Система управления обучением",
  "description": "Расписание, оценки и посещаемость",
  "teacher": "Елена Волкова",
  "durationHours": 40,
  "status": "draft"
}

### ПЗ2: полностью заменить созданный курс
PUT {{baseUrl}}/api/v1/courses/3
Content-Type: application/json

{
  "title": "Система управления обучением",
  "description": "Курсы, расписание и оценки",
  "teacher": "Елена Волкова",
  "durationHours": 44,
  "status": "published"
}

### ПЗ2: изменить только описание курса
PATCH {{baseUrl}}/api/v1/courses/3
Content-Type: application/json

{
  "description": "Курсы, расписание, оценки и посещаемость"
}

### ПЗ2: удалить созданный курс
DELETE {{baseUrl}}/api/v1/courses/3

### ПЗ2: список студентов и поиск
GET {{baseUrl}}/api/v1/students?search=Алексей

### ПЗ2: получить студента по ID
GET {{baseUrl}}/api/v1/students/1

### ПЗ2: создать студента (при чистом запуске его ID будет 3)
POST {{baseUrl}}/api/v1/students
Content-Type: application/json

{
  "fullName": "Иван Петров",
  "email": "ivan.petrov@lms.local",
  "group": "ИТ-21"
}

### ПЗ2: полностью заменить студента
PUT {{baseUrl}}/api/v1/students/3
Content-Type: application/json

{
  "fullName": "Иван Петров",
  "email": "ivan.petrov@lms.local",
  "group": "ИТ-22"
}

### ПЗ2: частично изменить группу студента
PATCH {{baseUrl}}/api/v1/students/3
Content-Type: application/json

{
  "group": "ИТ-23"
}

### ПЗ2: удалить созданного студента
DELETE {{baseUrl}}/api/v1/students/3

### ПЗ2: список занятий, связанных с курсом 1
GET {{baseUrl}}/api/v1/lessons?courseId=1

### ПЗ2: получить занятие по ID
GET {{baseUrl}}/api/v1/lessons/1

### ПЗ2: создать занятие для курса 1 (при чистом запуске ID будет 3)
POST {{baseUrl}}/api/v1/lessons
Content-Type: application/json

{
  "courseId": 1,
  "title": "Основы CSS",
  "description": "Селекторы, свойства и каскад",
  "orderNumber": 2,
  "durationMinutes": 90
}

### ПЗ2: полностью заменить занятие
PUT {{baseUrl}}/api/v1/lessons/3
Content-Type: application/json

{
  "courseId": 1,
  "title": "Основы CSS и адаптивная вёрстка",
  "description": "Стилизация и адаптация страницы",
  "orderNumber": 2,
  "durationMinutes": 100
}

### ПЗ2: частично изменить длительность занятия
PATCH {{baseUrl}}/api/v1/lessons/3
Content-Type: application/json

{
  "durationMinutes": 110
}

### ПЗ2: удалить созданное занятие
DELETE {{baseUrl}}/api/v1/lessons/3

### ПЗ2: ошибка валидации обязательных полей
POST {{baseUrl}}/api/v1/students
Content-Type: application/json

{
  "fullName": ""
}
