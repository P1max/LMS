@baseUrl = http://localhost:3000
@token = paste-token-here

### Зарегистрировать студента
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "student@lms.local",
  "password": "Student123!"
}

### Войти студентом
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "student@lms.local",
  "password": "Student123!"
}

### Войти администратором (пароль из seed)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@lms.local",
  "password": "Admin123!"
}

### Получить профиль текущего пользователя
GET {{baseUrl}}/profile
Authorization: Bearer {{token}}

### Получить пользователей (только для роли admin)
GET {{baseUrl}}/admin/users
Authorization: Bearer {{token}}

### Проверить защиту профиля без токена
GET {{baseUrl}}/profile

### Проверка сервера
GET {{baseUrl}}/

### Получить все курсы
GET {{baseUrl}}/courses

### Фильтрация по статусу и поиск
GET {{baseUrl}}/courses?status=published&search=web

### Получить курс по ID
GET {{baseUrl}}/courses/1

### Создать курс (после миграций и seed он получит ID 3)
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "title": "Электронный журнал",
  "description": "Оценки и посещаемость",
  "teacher": "Елена Волкова",
  "durationHours": 40,
  "status": "draft",
  "startDate": "2026-11-01T09:00:00.000Z"
}

### Полностью обновить созданный курс
PUT {{baseUrl}}/courses/3
Content-Type: application/json

{
  "title": "Электронный журнал",
  "description": "Оценки, расписание и посещаемость",
  "teacher": "Елена Волкова",
  "durationHours": 44,
  "status": "published",
  "startDate": "2026-11-05T09:00:00.000Z"
}

### Удалить созданный курс
DELETE {{baseUrl}}/courses/3

### Проверить ошибку 404 после удаления
GET {{baseUrl}}/courses/3

### MongoDB: получить курсы
GET {{baseUrl}}/mongo/courses

### MongoDB: создать курс с вложенными занятиями
# @name createMongoCourse
POST {{baseUrl}}/mongo/courses
Content-Type: application/json

{
  "title": "MongoDB для LMS",
  "description": "Документное хранение учебных данных",
  "teacher": "Елена Волкова",
  "durationHours": 24,
  "status": "draft",
  "tags": ["mongodb", "nosql"],
  "lessons": [
    {
      "title": "Документы и коллекции",
      "durationHours": 2,
      "topics": ["BSON", "ObjectId"]
    }
  ]
}

### MongoDB: добавить вложенное занятие
POST {{baseUrl}}/mongo/courses/{{createMongoCourse.response.body.$.data._id}}/lessons
Content-Type: application/json

{
  "title": "CRUD в Mongoose",
  "durationHours": 2,
  "topics": ["find", "create", "update", "delete"]
}

### MongoDB: получить созданный курс
GET {{baseUrl}}/mongo/courses/{{createMongoCourse.response.body.$.data._id}}

### MongoDB: изменить занятие внутри массива
PATCH {{baseUrl}}/mongo/courses/{{createMongoCourse.response.body.$.data._id}}/lessons/{{createMongoCourse.response.body.$.data.lessons[0]._id}}
Content-Type: application/json

{
  "title": "Документы, коллекции и BSON",
  "durationHours": 3
}

### MongoDB: изменить курс
PUT {{baseUrl}}/mongo/courses/{{createMongoCourse.response.body.$.data._id}}
Content-Type: application/json

{
  "title": "MongoDB для LMS: практика",
  "status": "published"
}

### MongoDB: неправильный ObjectId — ответ 400
GET {{baseUrl}}/mongo/courses/not-an-object-id

### MongoDB: удалить созданный курс вместе с занятиями
DELETE {{baseUrl}}/mongo/courses/{{createMongoCourse.response.body.$.data._id}}

### Проверить ошибку 400
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "title": ""
}
